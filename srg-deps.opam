opam-version: "2.0"
name: "srg-deps"
version: "dev"
synopsis: "Formalization of strongly regular graphs in Rocq"
maintainer: "Ejean Kuo, Jonathan Lee"
depends: [
  "ocaml" {>= "5.4.0"}
  "coq" {>= "9.1.0" & < "9.2~"}
  "coq-mathcomp-ssreflect" {>= "2.5.0"}
  "coq-mathcomp-fingroup" {>= "2.5.0"}
  "coq-mathcomp-algebra" {>= "2.5.0"}
  "coq-mathcomp-field" {>= "2.5.0"}
  "coq-graph-theory" {>= "0.9.7"}
  "coq-mathcomp-finmap" {>= "2.2.2" & < "2.2.4"}
]
build: [
  ["coq_makefile" "-f" "_CoqProject" "-o" "Makefile"]
  [make "-j%{jobs}%"]
]
install: [
  [make "install"]
]
